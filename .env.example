# URL base de la API .NET, INCLUDING el prefijo /api.
#
# Desarrollo local: PSAcademyBack arranca en http://localhost:5077 según
# Properties/launchSettings.json. Copia este archivo como ".env" y ajusta el puerto
# si en tu equipo corre en otro; si no existe, la app usa ese mismo valor por
# defecto (ver DEFAULT_API_BASE_URL en src/services/api.ts).
VITE_API_URL=http://localhost:5077/api
